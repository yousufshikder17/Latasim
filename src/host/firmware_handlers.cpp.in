// Generated by latasim_add_host_firmware (CMakeLists.txt) for @LATASIM_ENTRY@: binds
// the CMSIS interrupt handlers the firmware defines to the model's exceptions.
//
// firmware_shim.h renames each handler @LATASIM_ENTRY@_<name>. A name the firmware
// does not define resolves, through the MSVC linker's /alternatename, to this
// file's @LATASIM_ENTRY@_absent_handler, and is not bound. A handler of a Keil
// board driver the firmware uses (ADC_IRQHandler) is bound when the firmware
// defines none, as the driver's would be on the target.
#include <vector>

#include "lpc17xx/lpc1768.hpp"

namespace {
volatile int absent_marker;  // makes the placeholder's body unique, so it is never folded
}

extern "C" void @LATASIM_ENTRY@_absent_handler(void) { absent_marker = 1; }

@LATASIM_HANDLER_DECLS@

std::vector<int> @LATASIM_ENTRY@_bind_handlers(latasim::lpc17xx::Lpc1768& mcu) {
    std::vector<int> bound;
    const auto bind = [&](int irq, void (*handler)(), void (*driver_handler)()) {
        if (handler == @LATASIM_ENTRY@_absent_handler) handler = driver_handler;
        if (handler == nullptr) return;
        mcu.bind_handler(irq, handler);
        bound.push_back(irq);
    };
@LATASIM_HANDLER_BINDS@
    return bound;
}
