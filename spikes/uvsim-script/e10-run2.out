uv4 exited_by_itself=True exit=0 wall=6s
orphan_uv4=0
MAP 0xE0001000, 0xE0001FFF READ WRITE

FUNC void snap (void) {
  printf("CP%u FIO1DIR=%08X FIO2DIR=%08X FIO1PIN=%08X FIO2PIN=%08X FIO1SET=%08X FIO2SET=%08X PCONP=%08X joystick=%02X buttons=%02X\n", R0, _RDWORD(0x2009C020), _RDWORD(0x2009C040), _RDWORD(0x2009C034), _RDWORD(0x2009C054), _RDWORD(0x2009C038), _RDWORD(0x20
  if (R0 == 2) {
    PORT1 &= ~(1 << 23);
    printf("PRESS joystick UP: PORT1=%08X FIO1PIN=%08X\n", PORT1, _RDWORD(0x2009C034));
  }
  if (R0 == 3) {
    PORT2 &= ~(1 << 10);
    printf("PRESS INT0: PORT2=%08X FIO2PIN=%08X\n", PORT2, _RDWORD(0x2009C054));
  }
  if (R0 == 5) {
    PORT1 |= (1 << 23);
    PORT2 |= (1 << 10);
    printf("RELEASE both: FIO1PIN=%08X FIO2PIN=%08X\n", _RDWORD(0x2009C034), _RDWORD(0x2009C054));
  }
}

BS checkpoint, 1, "snap()"
G, finished
