uv4 exited_by_itself=True exit=0 wall=12s
orphan_uv4=0
MAP 0xE0001000, 0xE0001FFF READ WRITE

FUNC void on_config (void) {
  printf("STCTRL-WRITE states=%u STCTRL=%08X STRELOAD=%08X STCURR=%08X\n", states, _RDWORD(0xE000E010), _RDWORD(0xE000E014), _RDWORD(0xE000E018));
}
FUNC void on_tick (void) {
  printf("TICK states=%u FIO1PIN=%08X FIO2PIN=%08X\n", states, _RDWORD(0x2009C034), _RDWORD(0x2009C054));
}
SIGNAL void stop_at (float secs) {
  swatch (secs);
  _break_ = 1;
}

printf("RESET states=%u STCTRL=%08X STRELOAD=%08X STCURR=%08X STCALIB=%08X\n", states, _RDWORD(0xE000E010), _RDWORD(0xE000E014), _RDWORD(0xE000E018), _RDWORD(0xE000E01C))
RESET states=0 STCTRL=00000000 STRELOAD=00000000 STCURR=00000000 STCALIB=00000000
BA WRITE (unsigned long *)0xE000E010, 4, 1, "on_config()"
BS SysTick_Handler, 1, "on_tick()"
stop_at (0.105)
G
