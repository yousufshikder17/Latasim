uv4 exited_by_itself=True exit=0 wall=8s
orphan_uv4=0
MAP 0xE0001000, 0xE0001FFF READ WRITE

FUNC void on_led (void) {
  printf("W states=%u FIO1PIN=%08X FIO2PIN=%08X STCURR=%08X\n", states, _RDWORD(0x2009C034), _RDWORD(0x2009C054), _RDWORD(0xE000E018));
}
SIGNAL void stop_at (float secs) {
  swatch (secs);
  _break_ = 1;
}

BA WRITE (unsigned long *)0x2009C038, 8, 1, "on_led()"
BA WRITE (unsigned long *)0x2009C058, 8, 1, "on_led()"
stop_at (0.035)
G
