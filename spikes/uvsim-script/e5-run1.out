uv4 exited_by_itself=True exit=0 wall=38s
orphan_uv4=0

FUNC void snap (void) {
  printf("SNAP states=%u P1.28=%u P1.27=%u P2.2=%u FIO1PIN=%08X FIO2PIN=%08X ADCR=%08X\n",
         states, (_RDWORD(0x2009C034) >> 28) & 1, (_RDWORD(0x2009C034) >> 27) & 1,
         (_RDWORD(0x2009C054) >> 2) & 1, _RDWORD(0x2009C034), _RDWORD(0x2009C054), _RDWORD(0x40034000));
}
FUNC void gpio_hook (void)  { printf("HOOK-GPIO  states=%u\n", states); }
FUNC void alias_hook (void) { printf("HOOK-ALIAS states=%u\n", states); }

BS delay, 1, "snap()"
BA WRITE (unsigned long *)0x2009C020, 0x40, 1, "gpio_hook()"    // GPIO1 + GPIO2 blocks
BA WRITE (unsigned long *)0x23380400, 0x800, 1, "alias_hook()"  // bit-band alias of GPIO1..GPIO2 (0x2009C020..0x2009C05F)
snap()
