PRESS joystick UP: PORT1=5F7FC713 FIO1PIN=5F7FC713
CP3 FIO1DIR=B0000000 FIO2DIR=0000007C FIO1PIN=5F7FC713 FIO2PIN=00003F83 FIO1SET=10000000 FIO2SET=00000000 PCONP=042887DE joystick=08 buttons=00
PRESS INT0: PORT2=00003B83 FIO2PIN=00003B83
CP4 FIO1DIR=B0000000 FIO2DIR=0000007C FIO1PIN=5F7FC713 FIO2PIN=00003B83 FIO1SET=10000000 FIO2SET=00000000 PCONP=042887DE joystick=08 buttons=01
CP5 FIO1DIR=B0000000 FIO2DIR=0000007C FIO1PIN=5F7FC713 FIO2PIN=00003B87 FIO1SET=10000000 FIO2SET=00000004 PCONP=042887DE joystick=08 buttons=01
RELEASE both: FIO1PIN=5FFFC713 FIO2PIN=00003F87
printf("DONE g_id=%X FIO1PIN=%08X FIO2PIN=%08X\n", g_id, _RDWORD(0x2009C034), _RDWORD(0x2009C054))
