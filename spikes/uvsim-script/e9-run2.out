uv4 exited_by_itself=True exit=0 wall=6s
orphan_uv4=0
MAP 0xE0001000, 0xE0001FFF READ WRITE

FUNC void snap (void) {
  printf("CP%u DIR=%08X MASK=%08X PIN=%08X SET=%08X PCONP=%08X L8=%08X L16=%08X\n", R0, _RDWORD(0x2009C020), _RDWORD(0x2009C030), _RDWORD(0x2009C034), _RDWORD(0x2009C038), _RDWORD(0x400FC0C4), g_load8, g_load16);
}

printf("RESET states=%u PCONP=%08X FIO1DIR=%08X FIO1SET=%08X\n", states, _RDWORD(0x400FC0C4), _RDWORD(0x2009C020), _RDWORD(0x2009C038))
RESET states=0 PCONP=042887DE FIO1DIR=00000000 FIO1SET=00000000
BS checkpoint, 1, "snap()"
G, main
printf("MAIN states=%u PCONP=%08X\n", states, _RDWORD(0x400FC0C4))
MAIN states=5607 PCONP=042887DE
G, finished
