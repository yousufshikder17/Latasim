DEFINE unsigned long nbytes
DEFINE unsigned long ndump
DEFINE unsigned long dumping

SIGNAL void ssp1_tap (void) {
  while (1) {
    wwatch (SSP1_OUT);
    nbytes++;
    if (dumping && ndump < 48) {
      printf("B%02u %02X cs=%u\n", ndump, SSP1_OUT & 0xFF, (_RDWORD(0x2009C014) >> 6) & 1);
      ndump++;
    }
  }
}
FUNC void mark (unsigned long id) {
  printf("MARK %u states=%u ssp1_bytes=%u\n", id, states, nbytes);
}

